generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// OWNER dan BOT_MANAGER ditambahkan di AKHIR, bukan disisipkan sesuai hierarki, dan itu
/// disengaja: menyisipkan di tengah membuat Prisma menghasilkan migrasi tukar-tipe
/// (CREATE TYPE baru, ALTER COLUMN, DROP TYPE lama) yang mengunci tabel Account. Menambah di
/// akhir menghasilkan ALTER TYPE ... ADD VALUE yang aditif murni. Urutan di sini tidak punya
/// makna apa pun — hierarki peran hidup di src/lib/bot-control/permissions.ts.
enum AccountRole {
  ADMIN
  AGENT
  OWNER
  BOT_MANAGER
}

model Account {
  id                    String         @id @default(cuid())
  email                 String         @unique
  passwordHash          String
  name                  String
  role                  AccountRole    @default(AGENT)
  // Bumped whenever an account's credentials or privileges change (password
  // reset, role change). Every issued JWT carries the tokenVersion it was
  // minted with; the session check in src/middleware.ts compares it against
  // this column and rejects the request if they differ. Without it, JWT
  // sessions are fully stateless and survive password resets and demotions
  // for up to their 30-day expiry.
  tokenVersion          Int            @default(0)
  createdAt             DateTime       @default(now())
  assignedConversations Conversation[] @relation("AssignedAgent")
  notes                 Note[]
}

model WaNumber {
  id               String   @id @default(cuid())
  phoneNumber      String   @unique
  phoneNumberId    String
  wabaId           String
  accessToken      String
  coexistBaseUrl   String
  coexistApiKey    String
  coexistNumberKey String
  createdAt        DateTime @default(now())
}

model Contact {
  id              String        @id @default(cuid())
  phone           String        @unique
  name            String?
  avatarUrl       String?
  // Negative cache for avatar enrichment, mirroring Conversation.bookingCheckedAt.
  // Without it, `avatarUrl == null` cannot distinguish "never looked" from "looked,
  // and this contact genuinely has no profile photo" -- so every single inbound
  // message from a photo-less contact would re-fire a wa-coexist HTTP round-trip
  // forever. Stamped on every enrichment attempt, successful or not.
  avatarCheckedAt DateTime?
  source          String?
  createdAt       DateTime      @default(now())
  conversation    Conversation?
  notes           Note[]
  reminders       Reminder[]
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

model Conversation {
  id               String                @id @default(cuid())
  contactId        String                @unique
  contact          Contact               @relation(fields: [contactId], references: [id])
  botEnabled       Boolean               @default(true)
  assignedAgentId  String?
  assignedAgent    Account?              @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  status           ConversationStatus    @default(OPEN)
  pipelineStage    String                @default("new")
  bookingData      Json?
  bookingCheckedAt DateTime?
  // Snapshotted once from bookingData.orderChannel the first time a booking is found, then
  // never overwritten -- unlike the rest of bookingData (payment/hotel/etc., which keep
  // refreshing on ensureFreshBookingData's normal 24h cycle since they can genuinely change),
  // which platform a booking originated from is a permanent fact about it. Kept as its own
  // column (not read out of the bookingData JSON on every request) so the sidebar list's
  // badge doesn't depend on bookingData's freshness/shape at all.
  orderChannel     String?
  tripBrief        Json?
  lastMessageAt    DateTime              @default(now())
  // Null means "never opened" -- every inbound message counts as unread. Set to
  // now() whenever an agent opens this conversation's thread (see
  // src/app/api/conversations/[id]/read/route.ts) or a new inbound message
  // arrives while the thread is already open, so the sidebar's unread badge
  // (src/components/inbox/ConversationListItem.tsx) reflects what the agent has
  // actually seen rather than every message ever received.
  lastReadAt       DateTime?
  // Pins this conversation to the top of the inbox list, above the normal
  // lastMessageAt ordering -- currently only ever set on the one isTest sandbox
  // conversation (see isTest below), but kept as its own general-purpose flag
  // rather than folded into isTest so a real conversation could be pinned later
  // without overloading what isTest means.
  isPinned         Boolean               @default(false)
  // Marks the single sandbox conversation an admin talks to as if they were the
  // customer, to exercise the bot without ever reaching a real WhatsApp number.
  // Gates two things: sendMessage() skips the real Meta/wa-coexist dispatch
  // entirely for this conversation (see src/lib/send.ts), and
  // /api/conversations/[id]/test-message is the only route allowed to create an
  // INBOUND CUSTOMER message here instead of the real webhook.
  isTest           Boolean               @default(false)
  createdAt        DateTime              @default(now())
  messages         Message[]
  labels           LabelOnConversation[]
  knowledgeGaps    KnowledgeGapLog[]
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageChannel {
  OFFICIAL
  UNOFFICIAL
}

enum SentBy {
  BOT
  AGENT
  CUSTOMER
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id              String           @id @default(cuid())
  conversationId  String
  conversation    Conversation     @relation(fields: [conversationId], references: [id])
  externalId      String?          @unique
  direction       MessageDirection
  type            String
  content         String?
  mediaUrl        String?
  // Meta's own id for an inbound image/audio/video/document/sticker. Meta's
  // media URLs expire (~5 min) and require an Authorization header, so the
  // raw URL can't be stored for later display -- mediaUrl is instead computed
  // at read time as a proxy path (/api/media/{message.id}) that re-resolves
  // this id through the Graph API on each request. See src/lib/inbound.ts and
  // src/app/api/media/[messageId]/route.ts.
  mediaId         String?
  mimeType        String?
  // Only set for `document` messages, where Meta supplies the original filename.
  fileName        String?
  // The local Message this one quotes/replies to (WhatsApp's "reply" feature). Set from
  // Meta's inbound `context.id` (matched against the parent's externalId) or from the
  // agent's chosen reply target on send. Deliberately a self-relation to OUR row, not a
  // raw wamid column: it survives even if the parent's own wamid becomes unresolvable,
  // and lets the UI join straight to the parent's content/type/sender.
  replyToId       String?
  replyTo         Message?         @relation("MessageReplyTo", fields: [replyToId], references: [id])
  replies         Message[]        @relation("MessageReplyTo")
  // Set only when this OUTBOUND message was dispatched as a real Cloud API template message
  // (type: 'template', sent via sendTemplateMessage) -- the exact resolved structure at send
  // time: template name, substituted body text, and for a carousel, each card's real display
  // URL/body/buttons (see src/lib/meta/carousel-types.ts's SentTemplatePayload). Stored rather
  // than re-derived from the Template row so the bubble keeps rendering the message exactly as
  // sent even if that Template is later edited or deleted.
  templatePayload Json?
  channel         MessageChannel
  sentBy          SentBy
  agentId         String?
  botTrace        Json?
  deliveryStatus  DeliveryStatus   @default(PENDING)
  createdAt       DateTime         @default(now())

  // NOTE: there is deliberately no index on `content`. A plain btree index there
  // was actively harmful: Postgres caps a btree index entry at ~2704 bytes, but a
  // WhatsApp text message can be 4096 characters, so ingesting a long message
  // (a pasted itinerary, a long complaint) made prisma.message.create throw
  // "index row size ... exceeds btree version 4 maximum" and dropped a real
  // customer message. It also bought nothing: the search it was added for
  // (GET /api/conversations?q=...) is a `contains` / ILIKE '%q%' substring match,
  // which a default-opclass btree cannot serve at all. Search therefore falls back
  // to a sequential scan -- correct, and fine at one tour operator's message
  // volume. If that ever stops being true, the right fix is a GIN + pg_trgm
  // trigram index (needs the pg_trgm extension enabled), not a btree.
  @@index([conversationId, createdAt])
}

// What the bot could not answer, recorded as it happens. Until this existed
// the only way to learn the bot's blind spots was a manual read of the whole
// message history -- the 2026-08-06 audit of 870 messages that produced most
// of orchestrator.ts's branches. That does not repeat and does not scale.
// `reason` is deliberately a small closed set, not free text, so the settings
// page can group by it: 'no_facts_resolved' means the catalog had nothing for
// the classified topic, 'verification_failed' means it had something and the
// model reached past it anyway. Those need opposite fixes.
model KnowledgeGapLog {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  topic          String
  reason         String
  messageText    String
  createdAt      DateTime     @default(now())

  @@index([createdAt])
}

/// Satu pengiriman keluar yang tertunda, sedang diproses, atau gagal.
///
/// Sebelum ini, `sendMessage` menembak provider langsung dan sekali saja: provider down lima
/// detik berarti pesan itu hilang selamanya, dan satu-satunya jejaknya adalah satu baris
/// Message berstatus FAILED yang tidak bisa dicoba ulang oleh siapa pun. Karena Unofficial
/// adalah jalur kirim utama, itu tidak memadai untuk pemakaian nyata.
///
/// `maxAttempts` default 4, BUKAN 3 seperti tertulis di guidebook §6.6. Tangga retry di §16.1
/// mendaftarkan empat percobaan (segera, +30 detik, +2 menit, +10 menit) sebelum FAILED;
/// dengan maxAttempts 3, percobaan +10 menit tidak akan pernah tercapai dan tangga yang
/// didokumentasikan itu tinggal separuh. Angka di sini mengikuti tangga yang operasional.
model OutboundJob {
  id             String         @id @default(cuid())
  conversationId String
  messageId      String?
  channel        MessageChannel
  /// COEXIST (Unofficial) atau META (Official).
  provider       String
  /// Semua yang dibutuhkan worker untuk mengirim ulang tanpa membaca ulang state apa pun:
  /// nomor tujuan, teks, dan media. Tidak pernah memuat kredensial — worker mengambilnya
  /// sendiri dari WaNumber saat memproses.
  payload        Json
  /// QUEUED, SENDING, SENT, FAILED, RETRYING, CANCELLED.
  status         String         @default("QUEUED")
  attempts       Int            @default(0)
  maxAttempts    Int            @default(4)
  nextAttemptAt  DateTime?
  lastError      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([conversationId])
  /// Dipakai UI retry untuk menemukan job di balik satu bubble yang gagal.
  @@index([messageId])
}

/// Opt-in/opt-out per kontak, dasar campaign yang aman.
///
/// Baris yang TIDAK ADA berarti "belum pernah ditanya", dan diperlakukan sebagai opt-in
/// (lihat safety-guard.ts) — sama seperti perilaku hari ini, di mana consent belum pernah
/// dicatat sama sekali. Menjadikan ketiadaan baris sebagai opt-out akan langsung memblokir
/// setiap kontak yang sudah ada.
model ContactConsent {
  id        String   @id @default(cuid())
  contactId String   @unique
  optIn     Boolean  @default(true)
  optOut    Boolean  @default(false)
  source    String?
  note      String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Satu putaran keputusan bot, disimpan sebagai entitas tersendiri agar bisa diaudit.
///
/// `Message.botTrace` TETAP ditulis seperti sebelumnya dan tidak digantikan — bubble bot di
/// inbox masih membacanya, dan ribuan baris lama hanya punya itu. Tabel ini menjawab hal yang
/// tidak bisa dijawab kolom JSON pada pesan: putaran yang TIDAK PERNAH menghasilkan pesan sama
/// sekali (agent mengambil alih di tengah jalan, atau orchestrator melempar exception) dulu
/// tidak meninggalkan jejak apa pun.
///
/// `conversationId` dan `messageId` sengaja kolom string biasa, BUKAN relasi ber-foreign-key —
/// mengikuti guidebook §6.5. Alasannya konkret: src/app/api/conversations/[id]/clear
/// menjalankan message.deleteMany, jadi FK ke Message akan memaksa memilih antara memblokir
/// clear (RESTRICT) atau menghapus jejak audit (CASCADE). Keduanya salah untuk tabel audit —
/// catatan harus tetap hidup melebihi hal yang dicatatnya.
model BotDecisionRun {
  id             String    @id @default(cuid())
  conversationId String
  messageId      String?
  mode           String
  inboundText    String
  replyText      String?
  /// REPLIED, CLARIFIED, HANDOFF, FAILED, SKIPPED — pemetaan di decision-recorder.ts.
  status         String
  flowKey        String?
  flowVersion    Int?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  latencyMs      Int?
  /// Sudah melewati sanitizer sebelum ditulis (lihat trace-sanitizer.ts) — rahasia tidak
  /// pernah mendarat di database, bukan sekadar disembunyikan saat render.
  trace          Json
  knowledgeRefs  Json?
  verification   Json?
  /// Jejak langkah pipeline (src/lib/pipeline/steps.ts) untuk run ini: satu entri per BATAS
  /// step yang benar-benar dilewati, dengan status mulai/selesai/dilewati/berhenti/gagal.
  ///
  /// Satu KOLOM, bukan tabel sendiri: relasinya 1:1 dengan run, tidak pernah di-query per
  /// baris, dan selalu dibaca bersama run-nya. Tabel terpisah persis kesalahan yang baru
  /// dicabut dari repo ini (BotDecisionTriage) — daftar kedua yang tidak bisa di-join.
  ///
  /// NULL berarti run ini berjalan sebelum instrumentasi ada, atau lewat jalur yang tidak
  /// membawa tracer (mis. simulator Test Lab). Sudah lewat sanitizer, sama seperti `trace`.
  steps          Json?
  error          String?
  /// Tanda "keputusan ini perlu diperbaiki", diisi manusia. Dua kolom, bukan tabel sendiri:
  /// relasinya memang 1:1 dan tanpa foreign key, jadi tabel terpisah hanya memaksa halaman
  /// Decision Logs mengambil daftar kedua yang tidak bisa di-join — dan badge untuk keputusan
  /// di halaman ke-5 tidak pernah muncul karena daftar kedua itu dibatasi 200 baris.
  ///
  /// NULL berarti tidak ditandai. Membatalkan tanda mengosongkan keduanya, bukan menulis
  /// status 'RESOLVED': "pernah ditandai lalu dicabut" bukan informasi yang pernah dibaca
  /// siapa pun di sini, sementara jejaknya tetap ada di BotControlAuditLog.
  flaggedAt      DateTime?
  flagNote       String?

  @@index([conversationId])
  @@index([startedAt])
  @@index([status])
  /// Filter "hanya yang ditandai" dikerjakan di database, bukan di klien. Tanpa index, filter
  /// itu memindai seluruh tabel untuk menemukan segelintir baris yang biasanya ditandai.
  @@index([flaggedAt])
  /// Tidak ada di guidebook, tapi wajib: popover trace di inbox mencari baris ini BERDASARKAN
  /// messageId untuk setiap bubble bot. Tanpa index, itu sequential scan pada tabel yang
  /// tumbuh satu baris per balasan bot.
  @@index([messageId])
}

/// Satu badan knowledge yang ditulis operator dan dibaca bot lewat KnowledgeRevision.
///
/// Tabel ini DULU juga berisi cerminan `catalog/*.json` (32 baris bertipe katalog beserta
/// chunk-nya, ditulis sebuah indexer dan disegarkan lewat tombol "Index ulang katalog").
/// Cerminan itu dihapus: bot tidak pernah membacanya sekali pun — src/lib/bot/catalog.ts dan
/// knowledge.ts membuka file JSON-nya langsung dari disk dan tidak menyentuh prisma sama
/// sekali — jadi yang tersisa hanyalah salinan kedua dari data yang sudah ada, plus satu
/// langkah manual yang harus diingat supaya salinan itu tidak berbohong. Halaman Knowledge
/// Explorer sekarang membaca `catalog/` langsung (src/lib/bot-control/catalog-explorer.ts).
///
/// Kolom yang ikut hilang bersama cerminan itu: `sourcePath`, `metadata`, `lastSyncedAt`, dan
/// relasi `chunks` (model KnowledgeChunk dihapus seluruhnya — tidak ada pemakainya selain
/// indexer; managed knowledge menyimpan isinya di KnowledgeRevision.body).
model KnowledgeSource {
  id           String              @id @default(cuid())
  key          String              @unique
  title        String
  /// Selalu 'MANUAL' sejak cerminan katalog dihapus. Kolomnya dipertahankan karena SETIAP
  /// penjaga di knowledge-workflow.ts memakainya: mutation menolak baris bertipe lain, yang
  /// membuat penulis baru berbasis file gagal keras alih-alih diam-diam menimpa tulisan
  /// operator (larangan mutlak di CLAUDE.md).
  type         String
  status       String              @default("PUBLISHED")
  summary      String?
  /// Siapa yang bertanggung jawab atas isi sumber ini.
  ownerId      String?
  createdBy    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  revisions    KnowledgeRevision[]

  @@index([type])
  @@index([status])
  @@index([ownerId])
}

/// Satu versi isi dari sebuah KnowledgeSource yang dikelola operator. SDD Manage Second §7.4.
///
/// Model terpisah, bukan kolom tambahan di KnowledgeSource, karena yang dibutuhkan adalah
/// RIWAYAT: "apa yang bot ketahui pada tanggal itu" tidak bisa dijawab tabel yang hanya
/// menyimpan keadaan terakhir. Riwayat itu bukan teori — audit 870 pesan bulan Agustus
/// dikerjakan dengan menelusuri persis pertanyaan semacam itu.
///
/// `version` naik satu per satu per sumber, bukan global: nomor yang bisa diucapkan
/// ("kembalikan FAQ harga ke versi 3") jauh lebih berguna saat insiden daripada cuid.
///
/// PUBLISHED tidak bisa diedit. Mengubah revisi yang sudah terbit akan mengubah masa lalu, dan
/// riwayat yang menunjuk versi itu akan mendeskripsikan isi yang berbeda dari yang benar-benar
/// dipakai bot saat itu. Perubahan selalu berarti revisi baru.
model KnowledgeRevision {
  id                String          @id @default(cuid())
  knowledgeSourceId String
  knowledgeSource   KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)
  version           Int
  title             String
  /// Bentuknya didefinisikan di src/lib/bot-control/knowledge-body.ts (ManagedKnowledgeBody).
  body              Json
  summary           String?
  /// DRAFT atau PUBLISHED — dua status yang dipilih operator, lewat "Simpan draft" dan
  /// "Aktifkan". ARCHIVED ada sebagai status ketiga tapi tidak pernah dipilih siapa pun: dia
  /// ditulis otomatis ke revisi lama saat revisi baru diaktifkan, karena loader runtime
  /// (src/lib/bot/managed-knowledge.ts) membaca SEMUA baris PUBLISHED dan dua revisi aktif
  /// pada satu sumber akan membuat bot mengutip jawaban lama dan barunya sekaligus.
  status            String          @default("DRAFT")
  changeReason      String?
  createdBy         String?
  publishedBy       String?
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([knowledgeSourceId, version])
  @@index([knowledgeSourceId])
  @@index([status])
}

model Label {
  id            String                @id @default(cuid())
  name          String                @unique
  color         String
  conversations LabelOnConversation[]
}

model LabelOnConversation {
  labelId        String
  conversationId String
  label          Label        @relation(fields: [labelId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@id([labelId, conversationId])
}

model Note {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id])
  authorId  String
  author    Account  @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Reminder {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id])
  dueAt     DateTime
  note      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum TemplateType {
  OFFICIAL
  QUICK_REPLY
}

enum TemplateMetaStatus {
  APPROVED
  PENDING
  REJECTED
  NOT_APPLICABLE
}

// TEXT is every template this app supported before carousels: a single BODY component,
// dispatched today by pasting its text into the compose box. CAROUSEL adds up to 10 media
// cards (see Template.cards) and is only ever submitted/sent through the real Cloud API
// template pipeline (src/lib/meta/templates.ts, src/lib/meta/messages.ts) -- there is no
// "paste it as plain text" fallback for a carousel.
enum TemplateFormat {
  TEXT
  CAROUSEL
  // Meta's real LIMITED_TIME_OFFER component (a countdown banner) -- category is always
  // forced to MARKETING (a Meta requirement for this component). The actual expiration
  // timestamp is supplied per-send (see /api/send/template), not stored here.
  LTO
  // Not a distinct Meta component -- structurally just a BODY + a BUTTONS component
  // containing one COPY_CODE button. Modeled as its own format for the same reason the UI
  // presents it as its own template type: the real coupon code is a per-send runtime value,
  // never the submission-time example.
  COUPON
  // Same component shape as TEXT (optional HEADER/BODY/FOOTER/BUTTONS) -- Meta only
  // distinguishes it by locking category to AUTHENTICATION (OTP-style templates).
  AUTH
}

model Template {
  id                String             @id @default(cuid())
  name              String
  type              TemplateType
  format            TemplateFormat     @default(TEXT)
  // Meta's own id for this template, returned by the create-template Graph call.
  // Meta reviews templates asynchronously (often hours later) and reports the
  // outcome through the message_template_status_update webhook, keyed by this id
  // -- without storing it there is no way to ever reconcile the local metaStatus
  // back to what Meta actually decided, so it would stay stuck at PENDING forever.
  // Null for QUICK_REPLY templates, which never go to Meta.
  metaId            String?
  metaStatus        TemplateMetaStatus @default(NOT_APPLICABLE)
  category          String?
  body              String
  // Auto-derived at submission time from how many {{n}} placeholders the body actually
  // contains (see src/components/templates/BodyField.tsx's cursor-insert button) -- never
  // manually named by the admin. Each entry is a display label only (the bound field's own
  // label when variableBindings covers that position, else a generic "Variabel N"), read by
  // ComposeBox to label each fill-in input at send time.
  variables         Json?
  // Maps a variable's 1-indexed position (as a string, e.g. "1", "2" -- {{1}}, {{2}}) to a
  // src/lib/booking/variable-fields.ts field key (e.g. "package", "financialBalance"), chosen
  // once here at template-creation time. A position missing from this map is unbound -- the
  // agent fills it manually at send time (see ComposeBox's per-variable "Isi dari data..."
  // fallback picker). Applies to both OFFICIAL and QUICK_REPLY templates.
  variableBindings  Json?
  // TEXT/AUTH only: TemplateHeaderDef (see src/lib/meta/carousel-types.ts) -- None/Text/Image
  // URL/Video URL/Document URL. Media variants are uploaded via the Resumable Upload API at
  // submission time (same mechanism CAROUSEL cards use), never stored as a Meta handle here.
  header            Json?
  // TEXT/AUTH/COUPON only: a fixed footer line under the body (Meta caps this at 60
  // characters, and forbids variables in it).
  footer            String?
  // Only set when format is CAROUSEL: CarouselCardDef[] (see src/lib/meta/carousel-types.ts)
  // -- each card's own source media URL, body text, and buttons, exactly as submitted. The
  // source URL is re-uploaded to Meta fresh on every send (see uploadMetaMediaFromUrl):
  // Meta's own asset handles/ids from submission time are short-lived and cannot be reused.
  cards             Json?
  // LTO only: the countdown banner's fixed text (Meta caps this at 16 characters).
  offerTitle        String?
  // TEXT/AUTH/LTO only: optional top-level buttons (CarouselButtonDef[] -- same shape
  // carousel cards use, since Meta allows the same QUICK_REPLY/URL/PHONE_NUMBER types here).
  buttons           Json?
  // COUPON only: the button's fixed label and the placeholder code Meta needs to approve the
  // submission. The real, live code is supplied per-send instead (see /api/send/template) --
  // never this column, which would otherwise go stale the moment it's reused.
  couponButtonText  String?
  couponExampleCode String?
  createdAt         DateTime           @default(now())
}

model Settings {
  id                          Int            @id @default(1)
  defaultChannel              MessageChannel @default(OFFICIAL)
  // The team's working-hours window, "HH:MM" on a 24-hour clock, always read in Asia/Jakarta
  // (never the server's zone -- the VPS runs UTC). An end before the start is a night shift
  // and wraps midnight. Either one null, blank, or unparseable turns the feature off.
  //
  // This window does exactly ONE thing, and deliberately only one: when a conversation is
  // handed off to a human outside it, offHoursAutoReply is appended to the handoff message so
  // the customer knows when the team is back. It never stops the bot answering -- the bot
  // replies 24/7 through the LLM, and swapping a real answer for "we are closed" at 2am would
  // be a worse service, not a safer one. See offHoursHandoffNotice in
  // src/lib/bot/runtime-integration.ts and the handoff branch of src/lib/inbound.ts.
  workingHoursStart           String?
  workingHoursEnd             String?
  // Blank/null appends nothing. Unlike fallbackReply/handoffReply there is no code default to
  // fall back to: only the operator knows when their own team is back.
  offHoursAutoReply           String?
  // The bot's global mode. true ("On") = active for all chats -- every conversation's
  // botEnabled is bulk-set true on the OFF->ON toggle, and every new conversation defaults
  // to true while this is on. false ("Off") = inactive by default everywhere -- bulk-set
  // false on toggle, and an agent must manually flip a specific conversation's botEnabled
  // back on (src/app/api/conversations/[id]/toggle-bot) to activate the bot in just that
  // one chat. See src/app/api/bot/mode/route.ts.
  botAutoReplyAll             Boolean        @default(true)
  // When true, the bot never auto-replies to a contact whose phone is an Indonesian number
  // (country code 62) regardless of botAutoReplyAll -- an operator policy choice to have
  // agents handle domestic customers directly, letting the bot serve everyone else. See
  // src/lib/phone.ts's isIndonesianNumber and src/app/api/bot/indonesia-filter/route.ts.
  skipBotForIndonesianNumbers Boolean        @default(false)
  // Whether the LLM escalation layer runs on top of the explicit keyword gate. True is the
  // behaviour this column replaced: the rule `bot.handoff_on_human_request` shipped enabled,
  // was seeded enabled, and an unreadable rule row defaulted to enabled too -- so anything
  // other than @default(true) would silently turn a handoff path off on the day it migrated.
  // The keyword gate in src/lib/bot/escalation-classifier.ts is NOT behind this switch: a
  // customer who types "saya mau bicara dengan manusia" reaches a human either way. Read by
  // src/lib/bot/runtime-integration.ts, which falls back to true on any read failure.
  handoffOnHumanRequest       Boolean        @default(true)
  catalogSyncedAt             DateTime?
  // The two sentences the bot says that an operator may reword without a deploy, edited on
  // /chatbot. NULL or empty means "use the wording in the code" -- never "say nothing": an
  // operator who clears the box is reverting to the default, and forcing them to retype the
  // original sentence to do that is how a typo ends up permanently in the bot's mouth.
  // fallbackReply is read by src/lib/bot/orchestrator.ts on both of its give-up branches;
  // handoffReply by src/lib/inbound.ts, the one sentence every handoff sends. Both go through
  // src/lib/bot/runtime-integration.ts, which falls back to the code's constant on any failure.
  fallbackReply               String?
  handoffReply                String?
  // Which Ollama model src/lib/bot/llm.ts asks for, through the VPS's own Ollama daemon (no
  // other hosted-API fallback). A `-cloud` tag -- the production default -- makes that daemon
  // forward inference to ollama.com, so customer text and booking data DO leave the VPS; only a
  // local tag keeps inference on the machine. Verified 2026-09-10 via /api/tags (remote_host).
  ollamaModel                 String         @default("gemma4:31b-cloud")
  // --- Pengaman outbound (dulu kolom Json `safetyConfig` di tabel kebijakan channel) ---
  //
  // Empat angka yang dibaca src/lib/outbound/safety-guard.ts sebelum sebuah pesan benar-benar
  // keluar. Dulu satu kolom Json pada tabel tersendiri dengan siklus draft/review/approve/
  // publish; sekarang kolom biasa, disimpan langsung dari halaman Pengaturan.
  //
  // Batas bawahnya BUKAN hiasan dan tetap ditegakkan sebagai Zod di /api/settings (lihat
  // SAFETY_BOUNDS di safety-guard.ts): nol pada campaignRatePerMinute tidak "melonggarkan"
  // limit, ia mematikan gerbangnya; duplicateWindowMs 0 mematikan deteksi duplikat. Keduanya
  // perubahan perilaku yang menyamar sebagai setelan, dan satu ketikan jauhnya tanpa lantai.
  //
  // Default-nya persis konstanta yang sudah dipakai kode sejak sebelum tabel itu ada, sehingga
  // baris yang belum pernah disunting berperilaku sama seperti sebelum migrasi.
  campaignRatePerMinute       Int            @default(20)
  duplicateWindowMs           Int            @default(60000)
  providerFailureThreshold    Int            @default(5)
  providerFailureWindowMs     Int            @default(300000)
  /// Provider yang sedang dijeda darurat, mis. ["COEXIST"].
  ///
  /// SENGAJA kolomnya sendiri dan SENGAJA tidak ikut PATCH /api/settings. Jeda provider adalah
  /// tindakan operasional darurat, bukan konfigurasi yang direview: menaruhnya di jalur simpan
  /// yang sama dengan angka-angka di atas berarti sebuah penyimpanan yang tidak berhubungan
  /// bisa mengangkat jeda yang dipasang orang lain saat insiden. Satu-satunya yang menulisnya
  /// adalah /api/outbound-jobs/pause-provider dan resume-provider, langsung berlaku tanpa
  /// publish apa pun.
  pausedProviders             String[]       @default([])
}

/// Catatan setiap perubahan penting di Bot Control. SDD Manage Second §7.1.
///
/// Alasan ini ada sebagai tabel sendiri, bukan kolom di entitas yang berubah: pertanyaan yang
/// harus dijawab adalah "siapa mengubah apa, kapan, dan mengapa", dan pertanyaan itu melintasi
/// knowledge, Settings, dan decision log sekaligus. Kolom `updatedBy` pada masing-masing
/// entitas hanya menyimpan penulis TERAKHIR — perubahan sebelumnya hilang, dan justru
/// perubahan sebelumnya itu yang dicari orang saat bot mulai menjawab salah.
///
/// Semua kolom identitas sengaja string biasa, BUKAN relasi ber-foreign-key, dengan alasan yang
/// sama seperti BotDecisionRun di atas: catatan audit harus tetap hidup melebihi hal yang
/// dicatatnya. Akun yang dihapus tidak boleh menghapus jejak apa yang pernah ia publish.
///
/// Ini RIWAYAT, bukan diff. Tidak ada `before`/`after`: menyimpan nilai lama dan nilai baru
/// menjawab "buktikan ke pihak ketiga siapa mengubah apa" — masalah SaaS multi-tenant, bukan
/// masalah JVTO, di mana pelakunya selalu orang yang sama dan setiap entitas sudah menyimpan
/// nilainya sendiri yang sekarang berlaku. Yang tersisa adalah pertanyaan yang benar-benar
/// ditanyakan: kapan saya terakhir mengubah ini, dan kenapa.
///
/// Alamat jaringan dan identitas perangkat pemanggil juga tidak disimpan, dengan alasan yang
/// sama: satu tim kecil di satu kantor, dan tidak seorang pun pernah membukanya. Yang tersisa
/// hanyalah data lokasi dan perangkat rekan kerja yang tersimpan selamanya tanpa menjawab apa pun.
///
/// Baris dipangkas otomatis setelah satu tahun (pruneBotAuditLogs, dipanggil dari cron
/// outbound) — tanpa itu tabel ini tumbuh selamanya.
model BotControlAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  /// UPDATE, PUBLISH, ENABLE, DISABLE.
  action     String
  entityType String
  entityId   String?
  entityKey  String?
  /// Alasan yang ditulis operator. Dibersihkan lewat sanitizeTrace sebelum disimpan — teks
  /// bebas bisa memuat token yang di-paste, dan audit log tidak boleh jadi tempat rahasia.
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
