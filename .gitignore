# repo-specific
.worktrees/

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# bot catalog: data files ARE committed (wa-inbox is self-contained -- no Python
# agent-runtime dependency in production, see scripts/sync-agent-catalog.ts). The one
# exception is deployment-approval.json: a signed operator artifact, not source data, and
# must never land in version control -- same reason .env doesn't. See
# scripts/approve-deployment.ts and src/lib/bot/deployment-gate.ts.
catalog/deployment-approval.json

# agent-uploaded outbound attachments (see src/app/api/uploads/route.ts) -- real
# customer-facing files, never repo content
public/uploads/*
!public/uploads/.gitkeep

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.playwright-mcp
