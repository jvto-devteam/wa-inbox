DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
SESSION_SECRET="replace-with-32-byte-random-hex"
# Credentials for the admin account created by `prisma db seed`. Both are
# required — the seed throws if either is unset rather than falling back to a
# default. Use a throwaway value locally; use a generated one in production.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
META_ACCESS_TOKEN=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WABA_ID=""
COEXIST_BASE_URL="http://localhost:4000"
COEXIST_API_KEY=""
COEXIST_NUMBER_KEY=""
BOOKING_API_URL=""
BOOKING_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_URL="http://localhost:11434"
