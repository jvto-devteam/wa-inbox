DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
SESSION_SECRET="replace-with-32-byte-random-hex"
# Credentials for the admin account created by `prisma db seed`. Both are
# required — the seed throws if either is unset rather than falling back to a
# default. Use a throwaway value locally; use a generated one in production.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
META_ACCESS_TOKEN=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WABA_ID=""
COEXIST_BASE_URL="http://localhost:4000"
COEXIST_API_KEY=""
COEXIST_NUMBER_KEY=""
BOOKING_API_URL=""
BOOKING_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_URL="http://localhost:11434"
# Shared secret the scheduler presents (header: x-cron-secret) when calling
# POST /api/outbound-jobs/process, which drives the outbound retry ladder.
# Must be at least 24 characters or it is ignored entirely -- an unset or short
# value disables the header auth rather than opening the endpoint.
# Generate with: openssl rand -hex 32
OUTBOUND_CRON_SECRET=""

# ApiClient ids (comma-separated) allowed to READ GET /api/v1/summaries -- the
# privacy-stripped daily summary used by the JVTO second-brain Operator agent.
# Sender keys (javavolcano-touroperator, new-backoffice) do not need it.
# Empty = endpoint closed for every key (403).
SUMMARIES_READ_CLIENT_IDS=""

# Catatan untuk crew (Guest Brief): panggilan LLM kedua sesudah ringkasan chat, hanya untuk percakapan ber-booking.
# "1" = nyala. Kosong = mati (default).
CREW_NOTE_ENABLED=""
# Catatan crew dikirim ke new-backoffice (POST /crew-notes-api/booking-notes) dengan BOOKING_API_URL (asal/origin-nya) dan
# BOOKING_API_KEY di atas, sebagai header X-Internal-Token. BOOKING_API_KEY harus = INTERNAL_API_TOKEN new-backoffice.
# Kabar vendor kaos/Bali kini dikirim new-backoffice dan legacy untuk semua jalur ubah data. 1 = matikan kabar vendor dari
# wa-inbox (alur Aksi Booking) supaya vendor tidak menerima dua pesan. Nyalakan bersamaan dengan VENDOR_NOTIFY_MODE=live.
VENDOR_NOTICE_DISABLED=
# 1 = tutup SEMUA penulisan booking dari chat (terapkan otomatis, Setujui, Batalkan). Tamu mengubah data lewat customer portal.
BOOKING_WRITE_DISABLED=
